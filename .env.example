# ===========================================
# HrPortal Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/hrms_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your-secure-random-64-character-hex-string-here
JWT_EXPIRATION=86400000

# Geofence Configuration (Office Location)
GEOFENCE_LATITUDE=12.8246935
GEOFENCE_LONGITUDE=80.0452905
GEOFENCE_RADIUS=500

# Default Admin Password (used only for initial seeding)
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password

# Attendance Reminder Schedules (Cron Expressions)
ATTENDANCE_REMINDER_MORNING=0 50 9 * * ?
ATTENDANCE_REMINDER_EVENING=0 0 18 * * ?
